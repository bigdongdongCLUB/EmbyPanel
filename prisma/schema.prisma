// EmbyPanel Prisma schema (MVP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum PayCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AnomalyStatus {
  OPEN
  IGNORED
  RESOLVED
}

enum AnomalyType {
  MULTI_DEVICE_CONCURRENCY
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  name         String?
  passwordHash String
  // Encrypted sync password used for provisioning Emby users (AES-256-GCM)
  syncPasswordEnc String?
  syncPasswordIv  String?
  syncPasswordTag String?
  role         Role     @default(USER)
  enabled      Boolean  @default(true)
  balanceCents Int      @default(0)
  expiryReminderEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  embyLinks     EmbyUserLink[]
  anomalies     Anomaly[]
}

model Plan {
  id                    String   @id @default(cuid())
  name                  String
  durationDays          Int
  maxConcurrentStreams  Int      @default(1)
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  payCycle  PayCycle?
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])
  servers   SubscriptionServer[]

  @@index([userId, status])
  @@index([endAt])
}

model EmbyServer {
  id            String   @id @default(cuid())
  name          String
  baseUrl       String
  // API key is stored encrypted (prefer apiKeyEnc/iv/tag). apiKey kept for backward compat.
  apiKey        String?
  apiKeyEnc     String?
  apiKeyIv      String?
  apiKeyTag     String?
  enabled       Boolean  @default(true)
  lastHealthAt  DateTime?
  lastHealthOk  Boolean?
  lastHealthMsg String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptionLinks SubscriptionServer[]
  embyLinks         EmbyUserLink[]
  anomalies         Anomaly[]
  sessionSnapshots  SessionSnapshot[]

  @@index([enabled])
}

model SubscriptionServer {
  id              String @id @default(cuid())
  subscriptionId  String
  embyServerId    String

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  embyServer   EmbyServer   @relation(fields: [embyServerId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, embyServerId])
}

model EmbyUserLink {
  id           String   @id @default(cuid())
  userId       String
  embyServerId String
  embyUserId   String
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  embyServer EmbyServer @relation(fields: [embyServerId], references: [id], onDelete: Cascade)

  @@unique([userId, embyServerId])
  @@index([embyServerId])
}

model SessionSnapshot {
  id          String   @id @default(cuid())
  embyServerId String
  capturedAt  DateTime @default(now())
  sessionCount Int
  rawJson     Json?

  embyServer EmbyServer @relation(fields: [embyServerId], references: [id], onDelete: Cascade)

  @@index([embyServerId, capturedAt])
}

model Anomaly {
  id           String        @id @default(cuid())
  type         AnomalyType
  status       AnomalyStatus @default(OPEN)
  userId       String
  embyServerId String
  detectedAt   DateTime      @default(now())
  evidenceJson Json
  note         String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  embyServer EmbyServer @relation(fields: [embyServerId], references: [id], onDelete: Cascade)

  @@index([status, detectedAt])
  @@index([userId, detectedAt])
}

model JobRun {
  id        String   @id @default(cuid())
  jobName   String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  ok        Boolean?
  message   String?
}
