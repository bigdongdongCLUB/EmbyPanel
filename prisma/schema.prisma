// EmbyPanel Prisma schema (MVP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum PayCycle {
  TRIAL
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  TWO_YEARLY
}

enum ServerAssignStrategy {
  ALL
  LOAD_BALANCE
}

enum AnomalyStatus {
  OPEN
  IGNORED
  RESOLVED
}

enum AnomalyType {
  MULTI_DEVICE_CONCURRENCY
}

enum CardCodeType {
  BALANCE
  SUBSCRIPTION
}

enum CardCodeStatus {
  UNUSED
  USED
  DISABLED
}

enum ServiceOrderStatus {
  PENDING
  PAID
  CANCELED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  name         String?
  passwordHash String
  // Any JWT session issued before this time is invalid.
  sessionInvalidatedAt DateTime?
  // Encrypted sync password used for provisioning Emby users (AES-256-GCM)
  syncPasswordEnc String?
  syncPasswordIv  String?
  syncPasswordTag String?
  role         Role     @default(USER)
  enabled      Boolean  @default(true)
  // Maximum concurrent playing devices allowed for anomaly scan.
  // 0 means unlimited.
  maxConcurrentPlaybacks Int @default(1)
  // Non-default concurrent playback limit expires independently after it is set.
  maxConcurrentPlaybacksExpiresAt DateTime?
  balanceCents Int      @default(0)
  expiryReminderEnabled Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  embyLinks     EmbyUserLink[]
  anomalies     Anomaly[]
  usedCardCodes CardCode[]
  serviceOrders ServiceOrder[]
  vodRequests   VodRequest[]
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  description String?  // markdown/html
  enabled     Boolean  @default(true) // 可用状态：是否允许创建新订单/订阅
  visible     Boolean  @default(true) // 显示状态：前端是否展示

  // Pricing is flexible; store as JSON:
  // { trial: { priceCents, hours }, monthly: { priceCents }, ... }
  pricingJson Json?

  // server assignment strategy (set once; UI can lock later)
  serverAssignStrategy ServerAssignStrategy @default(LOAD_BALANCE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  serverConfigs PlanServerConfig[]
  cardCodes      CardCode[]
  serviceOrders  ServiceOrder[]
}

model PlanServerConfig {
  id             String   @id @default(cuid())
  planId         String
  embyServerId   String
  // Emby user id used as template for new users on this server
  templateEmbyUserId String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  embyServer EmbyServer @relation(fields: [embyServerId], references: [id], onDelete: Cascade)

  @@unique([planId, embyServerId])
  @@index([embyServerId])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String?
  status    SubscriptionStatus @default(ACTIVE)
  payCycle  PayCycle?
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan?              @relation(fields: [planId], references: [id])
  servers   SubscriptionServer[]

  @@index([userId, status])
  @@index([endAt])
}

model EmbyServer {
  id            String   @id @default(cuid())
  name          String
  baseUrl       String
  externalUrl   String?
  backupUrl     String?
  // API key is stored encrypted (prefer apiKeyEnc/iv/tag). apiKey kept for backward compat.
  apiKey        String?
  apiKeyEnc     String?
  apiKeyIv      String?
  apiKeyTag     String?
  enabled       Boolean  @default(true)
  lastHealthAt  DateTime?
  lastHealthOk  Boolean?
  lastHealthMsg String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptionLinks SubscriptionServer[]
  planServerConfigs PlanServerConfig[]
  embyLinks         EmbyUserLink[]
  anomalies         Anomaly[]
  sessionSnapshots  SessionSnapshot[]
  playbackEvents    PlaybackEvent[]

  @@index([enabled])
}

model SubscriptionServer {
  id              String @id @default(cuid())
  subscriptionId  String
  embyServerId    String

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  embyServer   EmbyServer   @relation(fields: [embyServerId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, embyServerId])
}

model EmbyUserLink {
  id           String   @id @default(cuid())
  userId       String
  embyServerId String
  embyUserId   String
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  embyServer EmbyServer @relation(fields: [embyServerId], references: [id], onDelete: Cascade)

  @@unique([userId, embyServerId])
  @@index([embyServerId])
}

model SessionSnapshot {
  id          String   @id @default(cuid())
  embyServerId String
  capturedAt  DateTime @default(now())
  sessionCount Int
  rawJson     Json?

  embyServer EmbyServer @relation(fields: [embyServerId], references: [id], onDelete: Cascade)

  @@index([embyServerId, capturedAt])
}

model PlaybackEvent {
  id           String   @id @default(cuid())
  embyServerId String
  activityId   String?
  embyUserId   String?
  userName     String?
  eventType    String
  mediaName    String
  mediaKey     String
  client       String?
  ip           String?
  occurredAt   DateTime
  sourceJson   Json?
  createdAt    DateTime @default(now())

  embyServer EmbyServer @relation(fields: [embyServerId], references: [id], onDelete: Cascade)

  @@unique([embyServerId, activityId])
  @@index([embyServerId, embyUserId, occurredAt])
  @@index([embyServerId, userName, occurredAt])
  @@index([occurredAt])
}

model Anomaly {
  id           String        @id @default(cuid())
  type         AnomalyType
  status       AnomalyStatus @default(OPEN)
  userId       String
  embyServerId String
  detectedAt   DateTime      @default(now())
  evidenceJson Json
  note         String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  embyServer EmbyServer @relation(fields: [embyServerId], references: [id], onDelete: Cascade)

  @@index([status, detectedAt])
  @@index([userId, detectedAt])
}

model CardCode {
  id        String         @id @default(cuid())
  code      String         @unique
  type      CardCodeType
  status    CardCodeStatus @default(UNUSED)

  // BALANCE card payload
  amountCents Int?

  // SUBSCRIPTION card payload
  planId          String?
  payCycle        PayCycle?
  subscriptionDays Int?

  batchTag String?
  note     String?

  usedAt    DateTime?
  usedByUserId String?
  usedByUser   User? @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([type, status, createdAt])
  @@index([planId])
}

model ServiceOrder {
  id        String             @id @default(uuid())
  userId    String
  planId    String
  payCycle  PayCycle
  days      Int
  trialHours Int?
  amountCents Int
  status    ServiceOrderStatus @default(PENDING)
  createdAt DateTime           @default(now())
  paidAt    DateTime?
  canceledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
}

model AppSetting {
  key       String   @id
  valueJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobRun {
  id        String   @id @default(cuid())
  jobName   String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  ok        Boolean?
  message   String?
}

enum VodMediaType {
  MOVIE
  TV
}

enum VodRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum VodBizStatus {
  PENDING
  NO_RESOURCE
  PROCESSING
  CANNOT_UPDATE
  COMPLETED
}

model VodRequest {
  id            String           @id @default(cuid())
  userId        String
  tmdbId        Int
  mediaType     VodMediaType
  title         String
  titleOriginal String
  posterPath    String?
  year          String?
  season        Int?
  note          String?
  status        VodRequestStatus @default(PENDING)
  bizStatus     VodBizStatus     @default(PENDING)
  adminNote     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([userId, bizStatus, createdAt])
  @@index([tmdbId, mediaType])
}
