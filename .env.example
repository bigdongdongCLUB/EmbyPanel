# EmbyPanel env example
# Copy to .env and fill values.

WEB_PORT=3000

POSTGRES_USER=embypanel
POSTGRES_PASSWORD=change_me
POSTGRES_DB=embypanel
POSTGRES_PORT=5432

REDIS_PASSWORD=change_me
REDIS_PORT=6379

# In docker-compose deployment, use service hostnames (db/redis).
# For local non-docker runtime, replace db/redis with localhost.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Public URL used by NextAuth callbacks (replace with your domain/IP)
NEXTAUTH_URL=http://localhost:${WEB_PORT}
NEXTAUTH_SECRET=change_me_base64_32bytes

# Encryption key for secrets stored in DB (base64, 32 bytes)
EMBYPANEL_ENCRYPTION_KEY=change_me_base64_32bytes

# Used to authorize internal job trigger endpoints (optional)
INTERNAL_JOBS_SECRET=change_me
